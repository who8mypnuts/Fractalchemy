   <property name="enabled"><bool>false</bool></property>
  </action>
  <action name="actionCopy">
   <property name="text"><string>Copy</string></property>
   <property name="toolTip"><string>Copy parameters (Ctrl+C)</string></property>
   <property name="shortcut"><string>Ctrl+C</string></property>
   <property name="statusTip"><string>Copy the fractal's parameters, including its gradient, as Fractalchemy text</string></property>
