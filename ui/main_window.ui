  <widget class="QStatusBar" name="statusbar"/>
  <action name="actionOpenFractal">
   <property name="text"><string>Open Fractal…</string></property>
   <property name="toolTip"><string>Open a fractal file</string></property>
   <property name="shortcut"><string>Ctrl+O</string></property>
   <property name="statusTip"><string>Open a .flame, .chaos or .fa file in the viewer</string></property>
  </action>
  <action name="actionSaveFractal">
   <property name="text"><string>Save Fractal</string></property>
   <property name="toolTip"><string>Save: overwrite the fractal's entry in its file (Ctrl+S)</string></property>
   <property name="shortcut"><string>Ctrl+S</string></property>
   <property name="statusTip"><string>Overwrite the entry the fractal came from; unsaved fractals ask for a file</string></property>
   <property name="enabled"><bool>false</bool></property>
  </action>
  <action name="actionSaveAs">
   <property name="text"><string>Save Fractal As</string></property>
   <property name="toolTip"><string>Save As: a new entry in this file, a new file, or into another file</string></property>
   <property name="enabled"><bool>false</bool></property>
  </action>
  <action name="actionSaveAsNewEntry">
   <property name="text"><string>As New Entry in This File…</string></property>
   <property name="statusTip"><string>Append the fractal to its own file under a name of your choosing</string></property>
  </action>
  <action name="actionSaveAsNewFile">
   <property name="text"><string>As New File…</string></property>
   <property name="shortcut"><string>Ctrl+Shift+S</string></property>
   <property name="statusTip"><string>Write the fractal to a new .flame or .fa file (an existing file is appended to)</string></property>
  </action>
  <action name="actionSaveAsIntoFile">
   <property name="text"><string>Into Existing File…</string></property>
   <property name="statusTip"><string>Append the fractal to another .flame or .fa file</string></property>
  </action>
  <action name="actionRandomBatch">
   <property name="text"><string>Random Batch…</string></property>
   <property name="toolTip"><string>Random Batch: generate random fractals from chosen variations (F7)</string></property>
   <property name="shortcut"><string>F7</string></property>
   <property name="statusTip"><string>Open the Random Batch window</string></property>
  </action>
  <action name="actionUndo">
   <property name="text"><string>Undo</string></property>
   <property name="toolTip"><string>Undo the last change to the fractal (Ctrl+Z)</string></property>
   <property name="shortcut"><string>Ctrl+Z</string></property>
   <property name="enabled"><bool>false</bool></property>
  </action>
  <action name="actionRedo">
   <property name="text"><string>Redo</string></property>
   <property name="toolTip"><string>Redo the change you undid (Ctrl+Shift+Z)</string></property>
   <property name="shortcut"><string>Ctrl+Shift+Z</string></property>
   <property name="enabled"><bool>false</bool></property>
  </action>
  <action name="actionCopyParameters">
   <property name="text"><string>Copy Parameters</string></property>
   <property name="toolTip"><string>Copy the fractal's parameters, gradient included, to the clipboard as .fa text (Ctrl+Shift+C)</string></property>
   <property name="shortcut"><string>Ctrl+Shift+C</string></property>
   <property name="enabled"><bool>false</bool></property>
  </action>
  <action name="actionPasteParameters">
   <property name="text"><string>Paste Parameters</string></property>
   <property name="toolTip"><string>Replace the fractal with parameters from the clipboard: .fa, Apophysis &lt;flame&gt; XML or a Chaotica world (Ctrl+Shift+V)</string></property>
   <property name="shortcut"><string>Ctrl+Shift+V</string></property>
  </action>
  <action name="actionExit">
   <property name="text"><string>Exit</string></property>
   <property name="shortcut"><string>Ctrl+Q</string></property>
   <property name="statusTip"><string>Quit Fractalchemy</string></property>
  </action>
  <action name="actionEditFractalLibrary">
   <property name="text"><string>Edit Fractal Library…</string></property>
   <property name="statusTip"><string>Add or remove the folders that make up the fractal library</string></property>
  </action>
  <action name="actionToggleFractalLibrary">
   <property name="checkable"><bool>true</bool></property>
   <property name="checked"><bool>true</bool></property>
   <property name="text"><string>Show/Hide Fractal Library</string></property>
   <property name="shortcut"><string>Ctrl+L</string></property>
  </action>
  <action name="actionRefreshFractalLibrary">
   <property name="text"><string>Refresh Fractal Library</string></property>
   <property name="shortcut"><string>F5</string></property>
  </action>
  <action name="actionThumbnailView">
   <property name="checkable"><bool>true</bool></property>
   <property name="checked"><bool>false</bool></property>
   <property name="text"><string>Thumbnails in Fractal Library</string></property>
   <property name="statusTip"><string>Show a rendered thumbnail next to every fractal</string></property>
  </action>
  <action name="actionToggleSettings">
   <property name="checkable"><bool>true</bool></property>
   <property name="checked"><bool>true</bool></property>
   <property name="text"><string>Show/Hide Settings Panel</string></property>
   <property name="shortcut"><string>Ctrl+Shift+L</string></property>
  </action>
  <action name="actionZoomFit">
   <property name="text"><string>Zoom to Fit</string></property>
   <property name="shortcut"><string>Ctrl+0</string></property>
   <property name="statusTip"><string>Show the whole image in the viewer</string></property>
  </action>
  <action name="actionZoomActual">
   <property name="text"><string>Zoom 100%</string></property>
   <property name="shortcut"><string>Ctrl+1</string></property>
   <property name="statusTip"><string>One image pixel per screen pixel</string></property>
  </action>
  <action name="actionShowStatusBar">
   <property name="checkable"><bool>true</bool></property>
   <property name="checked"><bool>true</bool></property>
   <property name="text"><string>Status Bar</string></property>
  </action>
  <action name="actionGradientLibrary">
   <property name="text"><string>Gradient Library</string></property>
   <property name="toolTip"><string>Gradient Library</string></property>
   <property name="statusTip"><string>Show the Gradient Library window to browse, edit and save gradients</string></property>
   <property name="shortcut"><string>F6</string></property>
  </action>
  <action name="actionFormulas">
   <property name="text"><string>Formulas…</string></property>
   <property name="toolTip"><string>Browse the loaded formulas (variations and plugins)</string></property>
  </action>
  <action name="actionAbout">
   <property name="text"><string>About Fractalchemy…</string></property>
  </action>
  <action name="actionAboutQt">
   <property name="text"><string>About Qt…</string></property>
