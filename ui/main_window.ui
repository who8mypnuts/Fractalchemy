  <action name="actionOpenFractal">
   <property name="text"><string>Open Fractal…</string></property>
   <property name="toolTip"><string>Open a fractal file</string></property>
   <property name="shortcut"><string>Ctrl+O</string></property>
   <property name="statusTip"><string>Open a .flame, .chaos or .fa file in the viewer</string></property>
  </action>
  <action name="actionSave">
   <property name="text"><string>Save</string></property>
   <property name="toolTip"><string>Save the fractal (Ctrl+S)</string></property>
   <property name="shortcut"><string>Ctrl+S</string></property>
   <property name="statusTip"><string>Write the fractal back into its file (Fractalchemy .fa by default)</string></property>
  </action>
  <action name="actionSaveAsNewEntry">
   <property name="text"><string>Add to This File as New Fractal…</string></property>
   <property name="shortcut"><string>Ctrl+Shift+A</string></property>
   <property name="statusTip"><string>Append the fractal to its own file under a new name (several fractals per file)</string></property>
  </action>
  <action name="actionSaveAsNewFile">
   <property name="text"><string>New File…</string></property>
   <property name="shortcut"><string>Ctrl+Shift+S</string></property>
   <property name="statusTip"><string>Save the fractal as a new .fa, .flame or .chaos file (an existing multi-fractal file is added to)</string></property>
  </action>
  <action name="actionSaveAsIntoFile">
   <property name="text"><string>Add to Another File…</string></property>
   <property name="statusTip"><string>Append the fractal to an existing .fa or .flame file</string></property>
  </action>
  <action name="actionUndo">
