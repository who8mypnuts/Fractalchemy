  <action name="actionRenderImage">
   <property name="text"><string>Render Image…</string></property>
   <property name="toolTip"><string>Render Image</string></property>
   <property name="shortcut"><string>Ctrl+R</string></property>
   <property name="statusTip"><string>Render the fractal to an image file at any size, with oversampling, filtering and denoising</string></property>
